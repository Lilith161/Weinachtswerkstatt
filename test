import msvcrt
import time

eingabe_puffer = ""
print("Gib eine Zahl ein (Programm läuft im Hintergrund weiter): ", end="", flush=True)

while True:
    # 1. Prüfen, ob eine Taste gedrückt wurde (blockiert nicht)
    if msvcrt.kbhit():
        taste = msvcrt.getwch()  # Liest einzelnes Zeichen ohne Enter

        # 2. Enter-Taste (\r) beendet die Eingabe und wandelt in int um
        if taste == '\r':
            print()  # Zeilenumbruch in der Konsole
            if eingabe_puffer:
                zahl = int(eingabe_puffer)
                print(f"Erfasste Zahl: {zahl} (Typ: {type(zahl).__name__})")
                eingabe_puffer = ""  # Puffer für nächste Eingabe leeren
            else:
                print("Keine Zahl eingegeben.")

        # 3. Backspace (\x08) ermöglicht das Korrigieren von Tippfehlern
        elif taste == '\x08':
            if len(eingabe_puffer) > 0:
                eingabe_puffer = eingabe_puffer[:-1]
                # Zeichen optisch aus der Konsole löschen
                print('\b \b', end="", flush=True)

        # 4. Ziffern (und optional ein Minus am Anfang) akzeptieren
        elif taste.isdigit() or (taste == '-' and len(eingabe_puffer) == 0):
            eingabe_puffer += taste
            print(taste, end="", flush=True)  # Getipptes Zeichen anzeigen

    # --- Hier läuft dein eigentlicher Programmcode weiter ---
    time.sleep(0.05)  # Entlastet die CPU
